# ==============================================================================
# MED-NET AI Environment Configuration Template
# ==============================================================================

# Backend API URL (Frontend consumption)
VITE_API_URL=http://localhost:8000

# Backend Server Host & Port
HOST=0.0.0.0
PORT=8000

# Optional LLM API Key (Gemini, OpenAI, or Anthropic) for Natural Language Dispatch Notes
# Note: MED-NET AI includes a full deterministic clinical explainability engine
# and functions 100% reliably without requiring an LLM API key.
LLM_API_KEY=

# Optional Routing & Turn-by-Turn API Key (OpenRouteService / Mapbox)
# Note: When omitted, high-precision Haversine distance with emergency response speed profiles is used.
ROUTING_API_KEY=
